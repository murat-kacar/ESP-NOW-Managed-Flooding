menu "Doorbell network"

    choice DB_TX_POWER
        prompt "Maximum TX power"
        default DB_TX_POWER_20DBM
        help
            Maximum Wi-Fi TX power (SPEC 7.6). 20 dBm is the ESP-IDF default maximum.

        config DB_TX_POWER_10DBM
            bool "10 dBm (lab bench)"
            help
                Sets 40 (0.25 dBm units, SPEC 7.6); ESP-IDF maps it to 34 = 8.5 dBm (esp_wifi_set_max_tx_power).
        config DB_TX_POWER_20DBM
            bool "20 dBm (field)"
    endchoice

    config DB_FORWARD_TTL
        int "Forward TTL (hops)"
        range 1 30
        default 10
        help
            Maximum number of hops (frame_head.forward_ttl). Default from esp-now
            ESPNOW_CONTROL_FORWARD_TTL. 31 means unlimited in esp-now and is not allowed.
            Not verified by field measurement yet (SPEC 9).

    config DB_FORWARD_RSSI_FILTER
        bool "Forward only packets received above an RSSI threshold"
        default n
        help
            Off: every module forwards every new message once, whatever its signal strength, as the relay nodes of
            BLE Mesh managed flooding do; the TTL and the esp-now message cache bound the traffic (ADR 0019).
            On: a module forwards only packets received at or above the threshold below
            (frame_head.forward_rssi, esp-now default -55 dBm).

    config DB_FORWARD_RSSI
        int "Forward RSSI threshold (dBm)"
        depends on DB_FORWARD_RSSI_FILTER
        range -70 -30
        default -70
        help
            Packets received weaker than this are not forwarded (frame_head.forward_rssi). Range from esp-now
            ESPNOW_CONTROL_FORWARD_RSSI; default -70, the lowest value, instead of the esp-now default -55, at which
            the range in the building test was too low (2026-11-06). To be set from the building's measured RSSI
            (SPEC 9).

    config DB_RETRANSMIT_COUNT
        int "Retransmit count"
        range 0 31
        default 10
        help
            Radio retransmissions per packet (frame_head.retransmit_count, 5-bit field).
            Default from esp-now ESPNOW_FRAME_CONFIG_DEFAULT.

    config DB_ACK_TIMEOUT_MS
        int "Application ACK timeout (ms)"
        range 50 5000
        default 400
        help
            Time to wait for RING_ACK / OPEN_DOOR_ACK (SPEC 7.4). esp-now has no default for
            end-to-end ACKs; 400 ms is the original specification value. Not verified yet (SPEC 9).

    config DB_PAIRING_WINDOW_S
        int "Pairing window (s)"
        range 10 120
        default 20
        help
            How long the panel scans and the unpaired module waits during pairing (SPEC 5.1).

    config DB_FILTER_WEAK_SIGNAL
        bool "Drop packets weaker than the forward RSSI threshold"
        depends on DB_FORWARD_RSSI_FILTER
        default n
        help
            frame_head.filter_weak_signal. Off in esp-now ESPNOW_FRAME_CONFIG_DEFAULT.

    config DB_REPLAY_COUNTER_BLOCK
        int "Replay counter NVS block size"
        range 1 10000
        default 100
        help
            The counter is persisted once per block of messages to limit flash wear (ADR 0002).
            To be set from usage data; proposed value, not verified (SPEC 9).

    config DB_HEARTBEAT
        bool "Module health reports (heartbeat)"
        default y
        help
            Each paired module reports its uptime, last reset reason and fault counters to the panel, and the panel
            logs a module that stays silent for 3 intervals (ADR 0015). Set the same value on both roles.

    config DB_HEARTBEAT_INTERVAL_S
        int "Heartbeat interval (s)"
        depends on DB_HEARTBEAT
        range 10 86400
        default 3600
        help
            Time between two reports of one module, with +/-10 % random jitter. Report traffic grows with the
            square of the module count (ADR 0015): about 27 frames/s for 99 modules at 3600 s. Use short intervals,
            for example 30 s, only for bench tests with a few modules. Set the same value on both roles.

    menu "Wi-Fi channel"
        comment "Candidate channels for the installation site scan (ADR 0006)."

        config DB_CHANNEL_DWELL_MS
            int "Pairing channel dwell time (ms)"
            range 100 5000
            default 500
            help
                Time the unpaired module waits on each candidate channel for the panel's HELLO_ACK (ADR 0012).
                After the first HELLO the panel listens for one full module cycle (3 x dwell) to notice a second
                module, so 6 x dwell must stay well below the pairing window.
                No official default exists; proposed value, not verified by bench test (SPEC 9).

        config DB_CHANNEL_CANDIDATE_1
            int "Candidate channel 1"
            range 1 13
            default 1
        config DB_CHANNEL_CANDIDATE_2
            int "Candidate channel 2"
            range 1 13
            default 6
        config DB_CHANNEL_CANDIDATE_3
            int "Candidate channel 3"
            range 1 13
            default 11
    endmenu

    menu "Wi-Fi regulatory and PHY"
        config DB_WIFI_COUNTRY_OVERRIDE
            bool "Set a Wi-Fi country code"
            default n
            help
                Off keeps the ESP-IDF default country setting. The country limits usable channels and TX power.
        config DB_WIFI_COUNTRY_CODE
            string "Country code (ISO 3166-1 alpha-2)"
            depends on DB_WIFI_COUNTRY_OVERRIDE
            default ""
        config DB_WIFI_LONG_RANGE
            bool "Enable ESP-NOW Long Range mode"
            default y
            help
                Espressif Long Range (LR) PHY: about 4 dB better reception sensitivity than 802.11b, in theory 2 to
                2.5 times the distance (ESP-IDF Wi-Fi driver guide). Adds LR to the radio protocols, as the ESP-IDF
                espnow example does, and sends every message at the LR rate below (esp_now_set_peer_rate_config on
                the broadcast peer). 802.11b/g/n stay enabled, so the panel's site scan still sees access points.
                Every device must use the same setting. An LR frame stays 2 to 4 times longer on air than at the
                default 1 Mbit/s: consider a lower retransmit count with it (ADR 0019). On by default (owner's
                decision 2026-11-06, for the range between floors); effect to be measured in the field.

        choice DB_WIFI_LR_RATE
            prompt "Long Range rate"
            depends on DB_WIFI_LONG_RANGE
            default DB_WIFI_LR_RATE_250K
            help
                250 kbit/s has the best sensitivity; 500 kbit/s halves the time on air.

            config DB_WIFI_LR_RATE_250K
                bool "250 kbit/s (longest range)"
            config DB_WIFI_LR_RATE_500K
                bool "500 kbit/s"
        endchoice
    endmenu

endmenu
